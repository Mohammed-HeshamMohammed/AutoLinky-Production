# Public mobile build inputs only. Never put Admin, SMTP, AI or service keys here.
# Generate ignored JSON with Node 24; see ENVIRONMENT_VARIABLES.md at repo root.
API_BASE_URL=https://appapi.auto-linky.com
SITE_URL=https://auto-linky.com
TERMS_URL=https://auto-linky.com/terms/
PRIVACY_URL=https://auto-linky.com/privacy/
# Match each platform's Firebase registration. Empty fields are omitted so the
# iOS preparer can use its native registration. Android needs its own values.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=auto-linky
FIREBASE_AUTH_DOMAIN=auto-linky.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=218018023814
FIREBASE_LINK_HOST=auto-linky.firebaseapp.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
EMAIL_LINK_CONTINUE_URL=
EMAIL_LINK_CUSTOM_DOMAIN=
EMAIL_SIGN_IN=false
APPLE_SIGN_IN=false
