# Copy to ignored .runtime/deployment/app.env; replace placeholders privately.
SERVICE_NAME=app
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4102
# Use Database-User's Internal Host from Dokploy and its existing postgres database.
PG_DATABASE_URL=postgresql://autolinky_app:SET_PRIVATE_PASSWORD@YOUR_DATABASE_USER_INTERNAL_HOST:5432/postgres
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
AUTH_SERVICE_URL=https://auth.auto-linky.com
AUTH_SERVICE_KEY=SAME_KEY_AS_AUTH_SERVICE
INTERNAL_DOWNLOADS_KEY=SET_PRIVATE_DOWNLOAD_STATS_KEY
# CV parsing starts a local Python worker only during an upload; no extractor URL/key.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
CV_AI_MODEL=google/gemini-2.5-flash
DATA_SERVICE_URL=https://data.auto-linky.com
APP_READ_KEY=replace-with-a-private-32-character-key
NOTIFY_SERVICE_URL=https://notify.auto-linky.com
NOTIFY_READ_KEY=replace-with-a-different-private-32-character-key
