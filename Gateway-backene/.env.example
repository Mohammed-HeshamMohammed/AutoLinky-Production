# Copy to ignored .runtime/deployment/gateway.env; replace placeholders privately.
SERVICE_NAME=gateway
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4100
AUTH_SERVICE_URL=http://auth:4101
AUTH_SERVICE_KEY=SAME_KEY_AS_AUTH_SERVICE
APP_SERVICE_URL=http://app:4102
APP_SERVICE_KEY=SAME_KEY_AS_APP_SERVICE
MESSAGING_SERVICE_URL=http://messaging:4103
MESSAGING_SERVICE_KEY=SAME_KEY_AS_MESSAGING_SERVICE
DATA_SERVICE_URL=http://data:4105
DATA_SERVICE_KEY=SAME_KEY_AS_DATA_SERVICE
