# Unified frontend: Node serves landing pages, browser apps, downloads and /v1.
# Start frontend/server.js on loopback 8080; set its API_BASE_URL to the gateway.
server {
    listen 80;
    server_name auto-linky.com www.auto-linky.com;
    return 301 https://auto-linky.com$request_uri;
}
server {
    listen 443 ssl;
    server_name auto-linky.com www.auto-linky.com;
    ssl_certificate /etc/letsencrypt/live/auto-linky.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auto-linky.com/privkey.pem;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
    }
}
