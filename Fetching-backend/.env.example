# Copy to ignored .runtime/deployment/fetching.env; replace placeholders privately.
SERVICE_NAME=fetching
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4104
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
COLLECTOR_ENABLED=false
FETCH_PROVIDERS_JSON={}
DATA_SERVICE_URL=https://data.auto-linky.com
DATA_INGESTION_KEY=replace-with-a-private-32-character-key
FETCHING_ADMIN_KEY=replace-with-a-console-only-private-32-character-key
