# Public configuration embedded in the React build. Never put secrets in VITE_*.
# Canonical site origin; route both auto-linky.com and www.auto-linky.com to port 8080 in Dokploy.
VITE_SITE_URL=https://auto-linky.com
VITE_WHATSAPP_NUMBER=201060933358
# Set to false to turn the download buttons off.
VITE_DOWNLOAD_ENABLED=true

# Server functions only. None of these use the VITE_ prefix.
RELEASES_REPO=AMamdouh3/Autolinky-releases
APK_FIXED_NAME=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
# Runtime public Firebase settings, served through /api/config (never Admin keys).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=auto-linky.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=auto-linky
PUBLIC_FIREBASE_STORAGE_BUCKET=auto-linky.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=218018023814
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
PUBLIC_FIREBASE_SDK_BASE_URL=https://www.gstatic.com/firebasejs/13.0.0/
# Gateway's existing internal Docker origin (port 4100) or configured HTTPS origin.
# Keep the working Dokploy value. appapi.auto-linky.com belongs to App, not Gateway.
# The local launcher supplies its own loopback value.
API_BASE_URL=
# Same value as the backend's INTERNAL_DOWNLOADS_KEY; at least 32 random characters.
STATS_KEY=
# Independent random value, at least 32 characters. Required for counting.
STATS_SALT=
