{
  "name": "@autolinky/integration-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:setup": "node scripts/environment/setup.js",
    "env:build": "node scripts/environment/build.js",
    "env:start": "node scripts/environment/start.js",
    "env:stop": "node scripts/environment/stop.js",
    "env:status": "node scripts/environment/status.js",
    "env:verify": "node scripts/environment/verify.js",
    "identity:reconcile": "node --env-file-if-exists=.env ../../Auth-backend/reconcile.js",
    "start": "npm run start:gateway",
    "dev": "node --env-file-if-exists=.runtime/environment/gateway.env --watch scripts/environment/service.js gateway",
    "sender": "node --env-file-if-exists=.runtime/environment/messaging.env scripts/environment/service.js sender",
    "migrate": "node --env-file-if-exists=.env ../../Data-baceknd/database/migrate.js",
    "migrate:check": "node --env-file-if-exists=.env ../../Data-baceknd/database/migrate.js --check",
    "test": "node --test test/*.test.js",
    "test:db": "node --test --test-concurrency=1 test/integration/*.test.js",
    "check": "node scripts/check-source.js",
    "start:gateway": "node --env-file-if-exists=.runtime/environment/gateway.env scripts/environment/service.js gateway",
    "start:auth": "node --env-file-if-exists=.runtime/environment/auth.env ../../Auth-backend/index.js",
    "start:app": "node --env-file-if-exists=.runtime/environment/app.env ../../App-backend/index.js",
    "start:messaging": "node --env-file-if-exists=.runtime/environment/messaging.env scripts/environment/service.js messaging",
    "start:fetching": "node --env-file-if-exists=.runtime/environment/fetching.env ../../Fetching-backend/index.js",
    "start:data": "node --env-file-if-exists=.runtime/environment/data.env scripts/environment/service.js data",
    "check:boundaries": "node scripts/check-service-boundaries.js",
    "install:backends": "node scripts/install-backends.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "he": "1.2.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "fast-check": "4.10.2",
    "node": "24.22.0"
  }
}
