{
  "name": "autolinky-backend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:setup": "node scripts/environment/setup.js",
    "env:build": "node scripts/environment/build.js",
    "env:start": "node scripts/environment/start.js",
    "env:stop": "node scripts/environment/stop.js",
    "env:status": "node scripts/environment/status.js",
    "env:verify": "node scripts/environment/verify.js",
    "identity:reconcile": "node --env-file-if-exists=.env services/auth/reconcile.js",
    "start": "npm run start:gateway",
    "dev": "node --env-file-if-exists=.runtime/environment/gateway.env --watch services/gateway/index.js",
    "sender": "node --env-file-if-exists=.runtime/environment/messaging.env services/messaging/sender.js",
    "migrate": "node --env-file-if-exists=.env database/migrate.js",
    "migrate:check": "node --env-file-if-exists=.env database/migrate.js --check",
    "test": "node --test test/*.test.js",
    "test:db": "node --test --test-concurrency=1 test/integration/*.test.js",
    "check": "node scripts/check-source.js",
    "start:gateway": "node --env-file-if-exists=.runtime/environment/gateway.env services/gateway/index.js",
    "start:auth": "node --env-file-if-exists=.runtime/environment/auth.env services/auth/index.js",
    "start:app": "node --env-file-if-exists=.runtime/environment/app.env services/app/index.js",
    "start:messaging": "node --env-file-if-exists=.runtime/environment/messaging.env services/messaging/index.js",
    "start:fetching": "node --env-file-if-exists=.runtime/environment/fetching.env services/fetching/index.js",
    "start:data": "node --env-file-if-exists=.runtime/environment/data.env services/data/index.js",
    "check:boundaries": "node scripts/check-service-boundaries.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "he": "1.2.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "fast-check": "4.10.2",
    "node": "24.22.0"
  }
}
