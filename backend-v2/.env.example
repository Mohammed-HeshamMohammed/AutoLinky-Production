NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PG_DATABASE_URL=postgresql://autolinky_api:change-me@127.0.0.1:5432/autolinky
PG_MIGRATOR_URL=postgresql://autolinky_migrator:change-me@127.0.0.1:5432/autolinky
PG_OPS_URL=
PG_POOL_MAX=8
PG_STATEMENT_TIMEOUT_MS=5000
FIREBASE_PROJECT_ID=auto-linky
# Use GOOGLE_APPLICATION_CREDENTIALS pointing to an untracked service-account file.
# The API never accepts emulator authentication in production.
GOOGLE_APPLICATION_CREDENTIALS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
INTERNAL_DOWNLOADS_KEY=
CV_EXTRACTOR_URL=http://127.0.0.1:4001
CV_EXTRACTOR_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
CV_AI_MODEL=
LETTER_AI_MODEL=
MAIL_SECRET_KEY=
SENDER_ENABLED=false
COLLECTOR_ENABLED=false
SERVICE_NOTICE=false
