# Private operations profile only. Runtime examples live in each root backend.
# Copy to ignored .env for the migrate/identity:reconcile CLI commands.
NODE_ENV=development
# For Dokploy operations, replace loopback with Database-User's Internal Host.
PG_MIGRATOR_URL=postgresql://autolinky_migrator:SET_PRIVATE_PASSWORD@127.0.0.1:5432/postgres
PG_OPS_URL=postgresql://autolinky_ops:SET_PRIVATE_PASSWORD@127.0.0.1:5432/postgres
FIREBASE_PROJECT_ID=auto-linky
GOOGLE_APPLICATION_CREDENTIALS=
DATA_SERVICE_URL=http://127.0.0.1:4105
