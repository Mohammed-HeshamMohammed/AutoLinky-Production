# Copy to ignored .runtime/deployment/data.env; replace placeholders privately.
SERVICE_NAME=data
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4105
# Use Database-User's Internal Host from Dokploy and its existing postgres database.
PG_DATABASE_URL=postgresql://autolinky_data:SET_PRIVATE_PASSWORD@YOUR_DATABASE_USER_INTERNAL_HOST:5432/postgres
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
DATA_PROCESSING_ENABLED=false
DATA_MAINTENANCE_ENABLED=false
DATA_INGESTION_KEY=replace-with-a-private-32-character-key
DATA_IDENTITY_KEY=replace-with-an-auth-only-private-32-character-key
# Same host/database as PG_DATABASE_URL; provision a separate restricted console login.
CONSOLE_DATABASE_URL=postgresql://autolinky_console_data:SET_PRIVATE_CONSOLE_PASSWORD@YOUR_DATABASE_USER_INTERNAL_HOST:5432/postgres
AUTH_SERVICE_URL=https://auth.auto-linky.com
AUTH_ADMIN_KEY=replace-with-a-data-to-auth-private-32-character-key
APP_SERVICE_URL=https://app.auto-linky.com
MESSAGING_SERVICE_URL=https://notify.auto-linky.com
FETCHING_SERVICE_URL=https://fetching.auto-linky.com
DATA_SERVICE_URL=https://data.auto-linky.com
NOTIFY_ADMIN_KEY=same-console-only-key-as-notify
FETCHING_ADMIN_KEY=same-console-only-key-as-fetching
