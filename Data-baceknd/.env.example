# Copy to ignored .runtime/deployment/data.env; replace placeholders privately.
SERVICE_NAME=data
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4105
PG_DATABASE_URL=postgresql://autolinky_data:SET_PRIVATE_PASSWORD@postgres:5432/autolinky
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
DATA_PROCESSING_ENABLED=false
DATA_MAINTENANCE_ENABLED=false
DATA_INGESTION_KEY=replace-with-a-private-32-character-key
DATA_IDENTITY_KEY=replace-with-an-auth-only-private-32-character-key
