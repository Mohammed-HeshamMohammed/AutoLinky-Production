{
  "name": "autolinky-frontend",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "dev": "vite --host 0.0.0.0",
    "build:site": "vite build && node scripts/prerender.mjs",
    "build:apps": "node scripts/build-apps.mjs",
    "build": "npm run build:site && npm run build:apps",
    "check": "npm run build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "vite": "^8.3.4"
  },
  "private": true
}
