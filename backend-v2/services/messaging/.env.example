# Copy to ignored .runtime/deployment/messaging.env; replace placeholders privately.
SERVICE_NAME=messaging
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4103
PG_DATABASE_URL=postgresql://autolinky_messaging:SET_PRIVATE_PASSWORD@postgres:5432/autolinky
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
AUTH_SERVICE_URL=http://auth:4101
AUTH_SERVICE_KEY=SAME_KEY_AS_AUTH_SERVICE
MAIL_SECRET_KEY=
AI_API_KEY=
SENDER_ENABLED=false
