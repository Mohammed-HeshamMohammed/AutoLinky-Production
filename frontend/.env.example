# Public configuration embedded in the React build. Never put secrets in VITE_*.
VITE_SITE_URL=https://auto-linky.com
VITE_WHATSAPP_NUMBER=201060933358
# Public GitHub repository whose newest release (with an .apk attached) the download buttons use. Optional.
VITE_RELEASES_REPO=AMamdouh3/Autolinky-releases
# Set to false to turn the download buttons off.
VITE_DOWNLOAD_ENABLED=true
