# Copy to ignored .runtime/deployment/auth.env; replace placeholders privately.
SERVICE_NAME=auth
NODE_ENV=production
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://auto-linky.com
PORT=4101
PG_DATABASE_URL=postgresql://autolinky_auth:SET_PRIVATE_PASSWORD@postgres:5432/autolinky
SERVICE_KEY=SET_UNIQUE_RANDOM_SERVICE_KEY
FIREBASE_PROJECT_ID=auto-linky
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
DATA_SERVICE_URL=http://data:4105
DATA_IDENTITY_KEY=replace-with-an-auth-only-private-32-character-key
ADMIN_SESSION_SECRET=replace-with-an-independent-private-32-character-key
ADMIN_TOTP_KEY=replace-with-32-random-bytes-encoded-as-base64url
AUTH_ADMIN_KEY=replace-with-a-data-to-auth-private-32-character-key
